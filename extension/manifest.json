{
  "manifest_version": 3,
  "name": "PureTube Shield — YouTube Không Quảng Cáo",
  "short_name": "PureTube Shield",
  "version": "1.0.0",
  "description": "Chặn quảng cáo YouTube, tự động bỏ qua tài trợ (SponsorBlock), phát nền không tạm dừng khi dùng Edge hoặc Chrome.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PureTube Shield — YouTube Không Quảng Cáo",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "declarativeNetRequest",
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://sponsor.ajay.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "puretube_adblock_rules",
        "enabled": true,
        "path": "rules/adblock_rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content_main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["adblock.css"],
      "js": ["content_bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
